-- TMA被动声纳测距演示 v1.0
-- 需要: tm_gpu (如果没有, 会自动回退到终端显示)
-- 自动模拟潜艇机动和目标运动, 演示纯被动方位测距

-- ========== 配置 ==========
local TMA_NOISE_DEG = 2.0        -- 方位噪声标准差 (度)
local MIN_TURN_ANGLE = 20.0      -- 有效机动的最小航向变化 (度)
local MIN_DATA_POINTS = 5        -- 开始解算的最小数据点数
local RECORD_INTERVAL = 10.0     -- 数据记录间隔 (秒)

-- ========== 初始化GPU ==========
local gpu = peripheral.find("tm_gpu")
local gpu_w, gpu_h = 256, 128
if gpu then
    pcall(gpu.refreshSize)
    pcall(gpu.setSize, 64)
    local ok, w, h = pcall(gpu.getSize)
    if ok then gpu_w, gpu_h = w, h end
else
    print("未找到tm_gpu, 将使用终端显示")
end

-- ========== 颜色常量 ==========
local COL_BG = 0x000000
local COL_OWN = 0xFFFFFF
local COL_TGT_TRUE = 0xFF0000
local COL_TGT_EST = 0x00FF00
local COL_LINE = 0xFFFF00
local COL_TEXT = 0x00FF00

-- ========== 模拟初始状态 ==========
local ownX, ownY = 0, 0
local ownHeading = 0            -- 航向 (度)
local ownSpeed = 2.0            -- 米/秒 (约4节)
local targetX, targetY = 2000, 500
local targetHeading = 180       -- 目标航向 (度)
local targetSpeed = 4.0         -- 米/秒 (约8节)

-- ========== 数据记录 ==========
local ownPositions = {}         -- {x, y}
local bearings = {}             -- 测得的带噪声绝对方位 (度)
local times = {}                -- 记录时的模拟时间
local isManeuvered = false
local solution = nil

-- ========== 辅助函数: 带噪声的方位测量 ==========
local function measureBearing()
    local dx = targetX - ownX
    local dy = targetY - ownY
    local trueBearing = math.deg(math.atan2(dx, dy))  -- atan2(x,y) 北顺时针
    trueBearing = (trueBearing + 360) % 360
    -- 添加近似高斯噪声
    local noise = (math.random() + math.random() + math.random() - 1.5) * TMA_NOISE_DEG * 1.2
    local measured = (trueBearing + noise + 360) % 360
    return measured, trueBearing
end

-- ========== 模拟机动 ==========
local function simulateManeuver(simTime)
    if simTime >= 120 and not isManeuvered then
        ownHeading = (ownHeading + 30) % 360
        isManeuvered = true
    end
end

-- ========== TMA解算: 简化最小二乘 ==========
local function solveTMA()
    if #bearings < MIN_DATA_POINTS or not isManeuvered then return nil end
    -- 仅使用机动后的数据
    local startIdx = nil
    for i = 1, #times do
        if times[i] >= 120 then startIdx = i; break end
    end
    if not startIdx then return nil end
    local X, Y, T, B = {}, {}, {}, {}
    for i = startIdx, #bearings do
        table.insert(X, ownPositions[i].x)
        table.insert(Y, ownPositions[i].y)
        table.insert(T, times[i])
        table.insert(B, bearings[i])
    end
    if #B < 4 then return nil end

    -- 初始猜测: 假设目标在第一个方位线2000米处, 速度与第一个方位垂直
    local initDist = 2000
    local ang = math.rad(B[1])
    local guessX = X[1] + initDist * math.sin(ang)
    local guessY = Y[1] + initDist * math.cos(ang)
    local guessVx = 3 * math.cos(ang)  -- 初始速度猜测3m/s
    local guessVy = -3 * math.sin(ang)

    -- 高斯-牛顿迭代简化版
    local state = {x0 = guessX, y0 = guessY, vx = guessVx, vy = guessVy}
    for _ = 1, 10 do
        local gradX, gradY = 0, 0
        for i = 1, #B do
            local t = T[i]
            local predX = state.x0 + state.vx * t
            local predY = state.y0 + state.vy * t
            local dx = predX - X[i]
            local dy = predY - Y[i]
            local predBear = math.deg(math.atan2(dx, dy)) % 360
            local diff = (B[i] - predBear + 180) % 360 - 180
            -- 数值偏导
            local eps = 1.0
            local f0 = predBear
            local fx = math.deg(math.atan2(dx+eps, dy)) % 360
            local fy = math.deg(math.atan2(dx, dy+eps)) % 360
            gradX = gradX + (fx - f0) / eps * diff
            gradY = gradY + (fy - f0) / eps * diff
        end
        state.x0 = state.x0 - 0.01 * gradX
        state.y0 = state.y0 - 0.01 * gradY
    end

    -- 计算当前估计距离、速度、航向
    local tNow = T[#T]
    local nowX = state.x0 + state.vx * tNow
    local nowY = state.y0 + state.vy * tNow
    local dx = nowX - X[#X]
    local dy = nowY - Y[#Y]
    local dist = math.sqrt(dx*dx + dy*dy)
    local speed = math.sqrt(state.vx*state.vx + state.vy*state.vy)
    local heading = math.deg(math.atan2(state.vx, state.vy)) % 360
    return {dist = dist, speed = speed, heading = heading}
end

-- ========== 运动更新 (每秒10次) ==========
local simTime = 0
local lastRecord = 0
local lastDraw = 0

local function update(dt)
    simTime = simTime + dt
    ownX = ownX + ownSpeed * math.sin(math.rad(ownHeading)) * dt
    ownY = ownY + ownSpeed * math.cos(math.rad(ownHeading)) * dt
    targetX = targetX + targetSpeed * math.sin(math.rad(targetHeading)) * dt
    targetY = targetY + targetSpeed * math.cos(math.rad(targetHeading)) * dt
    simulateManeuver(simTime)
end

-- ========== GPU绘制 ==========
local function drawGPU()
    if not gpu then return end
    gpu.fill(COL_BG)
    local scale = 0.05  -- 像素/米, 适合显示2000米范围
    local cx, cy = gpu_w/2, gpu_h/2
    -- 坐标转换函数
    local function toScreen(wx, wy)
        local sx = cx + (wx - ownX) * scale
        local sy = cy - (wy - ownY) * scale  -- 屏幕y轴反向
        return math.max(1, math.min(gpu_w, sx)), math.max(1, math.min(gpu_h, sy))
    end

    -- 绘制目标真实位置 (红色, 仅用于验证)
    local tx, ty = toScreen(targetX, targetY)
    gpu.line(tx-2, ty, tx+2, ty, COL_TGT_TRUE)
    gpu.line(tx, ty-2, tx, ty+2, COL_TGT_TRUE)

    -- 绘制本艇 (白色)
    local ox, oy = toScreen(ownX, ownY)
    gpu.line(ox-3, oy, ox+3, oy, COL_OWN)
    gpu.line(ox, oy-3, ox, oy+3, COL_OWN)

    -- 绘制最近的几条带噪声的方位线 (黄色虚线)
    for i = math.max(1, #bearings-3), #bearings do
        local ang = math.rad(bearings[i])
        local len = 3000  -- 线长
        local ex = ownPositions[i].x + len * math.sin(ang)
        local ey = ownPositions[i].y + len * math.cos(ang)
        local sx1, sy1 = toScreen(ownPositions[i].x, ownPositions[i].y)
        local ex1, ey1 = toScreen(ex, ey)
        for j = 0, 1 do
            gpu.line(sx1+j, sy1, ex1+j, ey1, COL_LINE)
        end
    end

    -- 显示解算结果
    if solution then
        gpu.drawText(2, 2, string.format("Dist: %.0f m", solution.dist), COL_TEXT, COL_BG, 1)
        gpu.drawText(2, 12, string.format("Spd: %.1f km/h", solution.speed * 3.6), COL_TEXT, COL_BG, 1)
        gpu.drawText(2, 22, string.format("Hdg: %.0f deg", solution.heading), COL_TEXT, COL_BG, 1)
    else
        gpu.drawText(2, 2, "Waiting for maneuver...", COL_TEXT, COL_BG, 1)
    end
    gpu.drawText(2, gpu_h-10, string.format("Time: %.0f s", simTime), COL_TEXT, COL_BG, 1)
    gpu.sync()
end

-- ========== 主循环 ==========
local function main()
    local startClock = os.clock()
    local lastTime = 0
    while true do
        local now = os.clock() - startClock
        local dt = now - lastTime
        lastTime = now
        if dt > 1 then dt = 0.1 end  -- 防止大跳跃

        update(dt)

        -- 每隔 RECORD_INTERVAL 记录一次
        if now - lastRecord >= RECORD_INTERVAL then
            local measuredBearing, trueBearing = measureBearing()
            table.insert(ownPositions, {x = ownX, y = ownY})
            table.insert(bearings, measuredBearing)
            table.insert(times, now)
            lastRecord = now
        end

        -- 尝试解算
        solution = solveTMA()

        -- 刷新显示
        if now - lastDraw >= 0.5 then
            if gpu then
                drawGPU()
            else
                term.clear()
                term.setCursorPos(1,1)
                print("TMA Simulation - Time: " .. math.floor(simTime) .. "s")
                print("Data points: " .. #bearings)
                print("Maneuvered: " .. tostring(isManeuvered))
                if solution then
                    print(string.format("Est. Distance: %.0f m", solution.dist))
                    print(string.format("Est. Speed: %.1f km/h", solution.speed * 3.6))
                else
                    print("Awaiting maneuver...")
                end
            end
            lastDraw = now
        end

        sleep(0.1)
    end
end

-- 启动
term.clear()
print("TMA Passive Ranging Demo")
print("Using GPU: " .. tostring(gpu ~= nil))
sleep(1)
main()
