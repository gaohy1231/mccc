-- TMA 被动声纳距离解算器 (Target Motion Analysis)
-- 模拟 WWII U-boat 攻击前的目标运动分析流程
-- 仅使用本艇 GPS 坐标和带噪声的目标绝对方位，估算目标距离与航速
-- 操作方法：启动后程序自动模拟潜艇和目标运动，实时显示采集数据和解算结果

-- ==========================================
-- 配置
-- ==========================================
local TMA_NOISE_DEG = 2.0    -- 方位测量噪声标准差（度）
local MIN_TURN_ANGLE = 20.0   -- 视为有效机动的最小航向变化（度）
local MIN_DATA_POINTS = 5     -- 开始解算的最小数据点数

-- ==========================================
-- 全局状态
-- ==========================================
local ownPositions = {}       -- 本艇位置历史 {x=, y=, t=}
local ownHeadings = {}        -- 本艇航向历史
local bearings = {}           -- 目标绝对方位（真北，度）
local times = {}              -- 时间戳
local solution = nil          -- 估算结果 {x0, y0, vx, vy, dist, speed_kph, heading}
local isManeuvered = false    -- 是否检测到机动
local tmaRunning = true

-- ==========================================
-- 模拟对象：本艇和目标
-- ==========================================
local ownX, ownY = 0, 0
local ownHeading = 0          -- 航向（度，真北顺时针）
local ownSpeed = 4.0          -- 节 = 约2.06 m/s
local targetX, targetY = 2000, 500   -- 目标初始坐标
local targetHeading = 180     -- 目标航向（真北顺时针），朝向180即向南
local targetSpeed = 8.0       -- 节 = 约4.12 m/s

-- ==========================================
-- 辅助函数：带噪声的目标方位测量
-- ==========================================
local function measureBearing()
    -- 计算真实绝对方位
    local dx = targetX - ownX
    local dy = targetY - ownY
    local trueBearing = math.deg(math.atan2(dx, dy)) -- atan2(x,y) -> 真北顺时针
    trueBearing = (trueBearing + 360) % 360
    -- 添加高斯噪声（近似）
    local noise = (math.random() + math.random() + math.random() - 1.5) * TMA_NOISE_DEG * 1.2
    local measuredBearing = (trueBearing + noise + 360) % 360
    return measuredBearing
end

-- ==========================================
-- 模拟潜艇机动：在某个时刻转向30度
-- ==========================================
local function simulateManeuver(now)
    if now > 120 and now < 121 then   -- 第120秒时开始转向
        ownHeading = ownHeading + 30   -- 右转30度
        isManeuvered = true
        term.clear()
        term.setCursorPos(1,1)
        print(">>> 潜艇执行 30° 右转！TMA 数据开始有意义 <<<")
    end
end

-- ==========================================
-- TMA 解算：非线性最小二乘（高斯-牛顿法）
-- ==========================================
local function solveTMA()
    if #bearings < MIN_DATA_POINTS then return nil end
    if not isManeuvered then return nil end   -- 未机动不解算

    -- 提取机动后的数据
    local idx1 = nil
    for i = 1, #bearings do
        if isManeuvered and (times[i] >= 120) then  -- 假设120秒后为机动后
            idx1 = i
            break
        end
    end
    if not idx1 then return nil end

    local X = {}
    local Y = {}
    local T = {}
    local B = {}
    for i = idx1, #bearings do
        table.insert(X, ownPositions[i].x)
        table.insert(Y, ownPositions[i].y)
        table.insert(T, times[i])
        table.insert(B, bearings[i])
    end
    if #B < 4 then return nil end

    -- 初始猜测：默认距离 2000 米，速度 10 节，航向与第一次方位垂直
    local firstBearing = B[1]
    local perpHeading = (firstBearing + 90) % 360
    local initialDist = 2000
    local initialSpeed = 5.0  -- m/s
    local guessX = X[1] + initialDist * math.sin(math.rad(firstBearing))
    local guessY = Y[1] + initialDist * math.cos(math.rad(firstBearing))
    local guessVx = initialSpeed * math.sin(math.rad(perpHeading))
    local guessVy = initialSpeed * math.cos(math.rad(perpHeading))

    -- 迭代优化
    local state = {x0 = guessX, y0 = guessY, vx = guessVx, vy = guessVy}
    for iter = 1, 10 do
        local Jx = {0,0,0,0}  -- 简化的雅可比矩阵计算（数值差分）
        local residuals = {}
        local sumSq = 0

        for i = 1, #B do
            local t = T[i]
            local predX = state.x0 + state.vx * t
            local predY = state.y0 + state.vy * t
            local dx = predX - X[i]
            local dy = predY - Y[i]
            local predBearing = math.deg(math.atan2(dx, dy))
            predBearing = (predBearing + 360) % 360
            local diff = (B[i] - predBearing + 180) % 360 - 180
            table.insert(residuals, diff)
            sumSq = sumSq + diff * diff

            -- 数值偏导（简化）
            local eps = 1.0
            local f0 = predBearing
            local fx = math.deg(math.atan2(dx + eps, dy))
            local fy = math.deg(math.atan2(dx, dy + eps))
            Jx[1] = Jx[1] + ((fx - f0) / eps) * diff
            Jx[2] = Jx[2] + ((fy - f0) / eps) * diff
        end

        -- 更新（简化梯度下降）
        local alpha = 0.001
        state.x0 = state.x0 - alpha * Jx[1]
        state.y0 = state.y0 - alpha * Jx[2]
        -- 速度分量保持固定？先只优化位置，稍后完善
        if sumSq < 1.0 then break end
    end

    -- 计算当前距离和速度
    local nowX = state.x0 + state.vx * T[#T]
    local nowY = state.y0 + state.vy * T[#T]
    local dx = nowX - X[#X]
    local dy = nowY - Y[#Y]
    local dist = math.sqrt(dx*dx + dy*dy)
    local speed = math.sqrt(state.vx*state.vx + state.vy*state.vy)
    local heading = math.deg(math.atan2(state.vx, state.vy)) % 360

    return {
        distance = dist,
        speed_mps = speed,
        speed_kph = speed * 3.6,
        heading = heading,
    }
end

-- ==========================================
-- 主循环
-- ==========================================
local function mainLoop()
    local startTime = os.clock()
    local lastRecordTime = 0
    local lastPrintTime = 0

    while tmaRunning do
        local now = os.clock() - startTime
        -- 模拟本艇运动
        ownX = ownX + ownSpeed * math.sin(math.rad(ownHeading)) * 0.2   -- 0.2秒步长
        ownY = ownY + ownSpeed * math.cos(math.rad(ownHeading)) * 0.2
        -- 目标运动
        targetX = targetX + targetSpeed * math.sin(math.rad(targetHeading)) * 0.2
        targetY = targetY + targetSpeed * math.cos(math.rad(targetHeading)) * 0.2

        -- 每 10 秒记录一次数据
        if now - lastRecordTime > 10 then
            simulateManeuver(now)
            local bearing = measureBearing()
            table.insert(ownPositions, {x=ownX, y=ownY})
            table.insert(ownHeadings, ownHeading)
            table.insert(bearings, bearing)
            table.insert(times, now)
            lastRecordTime = now
        end

        -- 尝试解算
        solution = solveTMA()

        -- 每 2 秒刷新终端显示
        if now - lastPrintTime > 2 then
            term.clear()
            term.setCursorPos(1,1)
            print("=== TMA 被动测距演示 ===")
            print(string.format("记录点数: %d", #bearings))
            print(string.format("潜艇机动: %s", isManeuvered and "已完成" or "未机动"))
            if solution then
                print("--------------------")
                print(string.format("估算距离: %.0f 米", solution.distance))
                print(string.format("目标速度: %.1f km/h", solution.speed_kph))
                print(string.format("目标航向: %.0f°", solution.heading))
            else
                print("等待机动和数据...")
            end
            lastPrintTime = now
        end

        sleep(0.1)  -- 模拟实时
    end
end

-- ==========================================
-- 启动
-- ==========================================
term.clear()
print("启动被动 TMA 演示...")
print("潜艇将先直航，约2分钟后右转30°")
sleep(2)
mainLoop()
